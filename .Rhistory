library(drc)
# Read the CSV file into R, and name it raw_data
raw_data <- read.csv("Test_data.csv", header = TRUE)
# Step 1 - Calculate Blank and relative values
# Blank of all media only wells
Blank_Average <- mean(mean(raw_data$Blank_L), mean(raw_data$Blank_R))
# If you have a media + drug (no cells control), e.g. in rows 1-3 of Blank_R
Media_drug1_control <- mean(raw_data$Blank_R[1:3])
# Calculate Live cells average  (Live.DMSO rows 1-3)
Live_cells <- mean(raw_data$Live.DMSO[1:3]) - Blank_Average
# Calculate DMSO control average (Live.DMSO rows 4-6)
DMSO_cells <- mean(raw_data$Live.DMSO[4:6]) - Blank_Average
# ----------------------------------------------------------------
# Step 2 - Calculate Amp_B at each concentration
Amp_all <- raw_data[, 3:5] # extract AmpB columns
Amp_all$Average <- rowMeans(Amp_all) # create a column of row averages
Amp_all$Average_minus_blank <- Amp_all$Average - Blank_Average # remove the blank value
Amp_all$viability <- (Amp_all$Average_minus_blank / Live_cells)*100 # calculate percentage viability
Amp_all$conc <- c(1.8, 0.6, 0.2, 0.067, 0.022, 0.0074) # add in the uM concentrations (highest-lowest)
# Function to calculate the LC50 and plot the dose-response curve
calculate_lc50 <- function(data, drug_name){
# force max viability to 100%, or max in results if over 100
max_viability <- max(max(data$viability), 100)
# create a model of the results comparing viability against concentration
model <- drm(viability ~ conc, data = data, fct = LL.4(fixed = c(NA, 0, max_viability, NA),
names = c("Slope", "Lower Limit", "Upper Limit", "ED50")))
# print the LC50 value
ic50_result <- ED(model, 50, type = "absolute", interval = "delta")
ic50_value <- ic50_result[1, "Estimate"]
cat("The calculated IC50 is:", ic50_value, "\n\n")
# Plot the dose-response curve
plot(model, log = "x", # model as input, x axis as log transformed
main = paste("Dose-response curve:", drug_name), # title
xlab = "Concentration (µM)", # x axis label
ylab = "Percent Viability") # y axis label
}
calculate_lc50(Amp_all, "Amphotericin B") # run the function for AmpB
# ----------------------------------------------------------------
# Step 3 - Calculate drug 1 at each concentration
# Same as for AmpB, but comparison against DMSO cells
Drug1_all <- raw_data[, 6:8] # extract Caffeic Acid columns
Drug1_all$Average <- rowMeans(Drug1_all) # create a column of row averages
Drug1_all$Average_minus_blank <- Drug1_all$Average - Blank_Average # remove the blank value
Drug1_all$viability <- (Drug1_all$Average_minus_blank / DMSO_cells)*100 # calculate percentage viability against DMSO control
#Drug1_all$viability <- pmin(Drug1_all$viability, 100)
Drug1_all$conc <- c(277.5, 138.7, 69.4, 34.7, 17.3, 8.67) # add in the uM concentrations (highest-lowest)
calculate_lc50(Drug1_all, "Caffeic Acid") # run the function for Caffeic Acid
# ----------------------------------------------------------------
# Step 4 - Calculate drug 2 at each concentration
# Same as drug 1
Drug2_all <- raw_data[, 9:12] # extract Caffeic Acid columns
Drug2_all$Average <- rowMeans(Drug2_all) # create a column of row averages
Drug2_all$Average_minus_blank <- Drug2_all$Average - Blank_Average # remove the blank value
Drug2_all$viability <- (Drug2_all$Average_minus_blank / DMSO_cells)*100 # calculate percentage viability against DMSO control
#Drug1_all$viability <- pmin(Drug1_all$viability, 100)
Drug2_all$conc <- c(141.32, 70.66, 35.33, 17.67, 8.83, 4.42) # add in the uM concentrations (highest-lowest)
calculate_lc50(Drug2_all, "CD9") # run the function for CD9
# functions
calculate_dilutions <- function(highest_conc, dilution_factor, dilutions=5){
# Use exponents to divide by 3 raised to the power of 0 through 5
result_vector <- highest_conc / (dilution_factor^(0:dilutions))
return(result_vector)
}
# calculate drug dilutions
ampB_dilutions <- calculate_dilutions(1.8, 3)
Drug1_dilutions <- calculate_dilutions(277.5, 2)
Drug2_dilutions <- calculate_dilutions(141.32, 2)
